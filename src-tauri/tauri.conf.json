{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdventVillage",
  "version": "0.1.7",
  "identifier": "com.adventvillage.app",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "크리스마스 어드벤트 마을",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
